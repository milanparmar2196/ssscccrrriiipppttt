{
  "name": "@scriptwriter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:validate": "tsx src/seeds/cli.ts validate",
    "seed:import": "tsx src/seeds/cli.ts import"
  },
  "dependencies": {
    "@scriptwriter/shared": "workspace:*",
    "fastify": "^5.2.0",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5",
    "jose": "^5.9.6",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.34.2",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "vitest": "^2.1.8",
    "@types/archiver": "^6.0.3"
  }
}