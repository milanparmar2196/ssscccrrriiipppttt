# Server environment (personal project). NEVER commit a real .env.
# --- API ---
AUTH_JWT_SECRET=
PORT=4000
DATABASE_URL=postgres://localhost:5432/scriptwriter
REDIS_URL=redis://localhost:6379
# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=scriptwriter
S3_ACCESS_KEY=
S3_SECRET_KEY=
# --- Bootstrap super-admin (A9: setup + recovery only) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# --- Transactional email (provider-agnostic) ---
EMAIL_PROVIDER=
EMAIL_FROM=
# --- YouTube token encryption key (A10) ---
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# --- AI model provider keys (MODEL_PROVIDERS.md; keys live ONLY here) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
ALIBABA_API_KEY=
XIAOMI_API_KEY=
MINIMAX_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4000/me/youtube/callback
# Local file storage when S3 is not configured (dev default)
STORAGE_DIR=.storage
